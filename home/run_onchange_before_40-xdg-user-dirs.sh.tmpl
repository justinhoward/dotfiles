{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Create configured dirs on first apply and when this script or its config changes,
# before installing the config.
# Otherwise xdg-user-dirs-update can reset missing dirs to $HOME on login.
set -eu

# Embed the managed config so the paths have a single source of truth.
{{ include "dot_config/user-dirs.dirs" }}
mkdir -p \
  "$XDG_DESKTOP_DIR" \
  "$XDG_DOCUMENTS_DIR" \
  "$XDG_DOWNLOAD_DIR" \
  "$XDG_MUSIC_DIR" \
  "$XDG_PICTURES_DIR" \
  "$XDG_PUBLICSHARE_DIR" \
  "$XDG_TEMPLATES_DIR" \
  "$XDG_VIDEOS_DIR"
{{- end }}
